rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── 100% Zero-Read In-Memory Helper Functions ─────────────────
    // ZERO get() or exists() calls! Zero document reads! Pure token & auth evaluation!

    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Evaluated 100% in-memory via email check or Custom Claims (0 reads)
    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'amarbazar27@gmail.com' ||
          request.auth.token.email == 'rafiqunnabi07@gmail.com' ||
          request.auth.token.email == 'rafiqunnabi29@gmail.com' ||
          request.auth.token.email == 'bdretailers26@gmail.com' ||
          request.auth.token.email == 'missionedu306@gmail.com' ||
          request.auth.token.email == 'contact@bdretailers.com'
        )) ||
        request.auth.token.get('role', '') == 'superadmin'
      );
    }

    // Evaluated 100% in-memory via Custom Claims (0 reads)
    function isSubSuperAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.get('role', '') == 'sub_superadmin'
      );
    }

    // Evaluated 100% in-memory: shopId is the retailer's UID or stored in token claims (0 reads)
    function isShopOwner(shopId) {
      return isAuthenticated() && (
        request.auth.uid == shopId ||
        request.auth.token.get('shopId', '') == shopId
      );
    }

    // Evaluated 100% in-memory via Custom Claims (0 reads)
    function isStaffOf(shopId) {
      return isAuthenticated() && (
        request.auth.token.get('role', '') in ['staff', 'admin'] &&
        (request.auth.token.get('accessShopId', '') == shopId || request.auth.token.get('shopId', '') == shopId)
      );
    }

    // Evaluated 100% in-memory (0 reads)
    function isShopAdmin(shopId) {
      return isShopOwner(shopId) || isSuperAdmin() || isSubSuperAdmin() || isStaffOf(shopId);
    }

    function isUnchanged(field) {
      return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
    }

    // Evaluated 100% in-memory: blocks privilege escalation without database reads (0 reads)
    function isValidRoleAssignment() {
      let role = request.resource.data.get('role', 'user');
      return role != 'superadmin' && role != 'sub_superadmin';
    }

    // ── Config & Invites ──────────────────────────────────────────
    match /config/global {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /config/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /sub_superadmins/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /retailer_requests/{docId} {
      allow create: if isAuthenticated() && request.auth.uid == docId &&
                    (request.resource.data.status in ['pending', 'approved']);
      allow read: if isSubSuperAdmin() || (isAuthenticated() && request.auth.uid == docId);
      allow update: if isAuthenticated() && request.auth.uid == docId &&
                    (
                      request.resource.data.status in ['pending', 'approved'] || 
                      (request.resource.data.status == resource.data.status)
                    );
      allow update, delete: if isSuperAdmin();
    }
    
    match /retailer_invites/{docId} {
      allow read: if isSubSuperAdmin() || isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ── Users ─────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSubSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
      
      // Apply secure role validation on creation (0 reads)
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidRoleAssignment();
      
      // Apply secure role validation on update (0 reads)
      allow update: if isAuthenticated() && request.auth.uid == userId
                    && (
                      (isUnchanged('role') && isUnchanged('accessShopId')) ||
                      isValidRoleAssignment()
                    );
      allow delete: if false;
    }

    // ── Shops & Sub-collections ───────────────────────────────────
    match /shops/{shopId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == shopId;
      allow update: if isShopAdmin(shopId);
      allow delete: if isSuperAdmin();

      match /products/{productId} {
        allow read: if true;
        allow write: if isShopAdmin(shopId);
      }

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isShopOwner(shopId) || isSuperAdmin();
      }

      match /orders/{orderId} {
        allow create: if false; 
        allow read: if isShopAdmin(shopId) || isSubSuperAdmin() || (isAuthenticated() && resource.data.customerEmail == request.auth.token.email);
        allow update, delete: if isShopAdmin(shopId);
      }

      match /incomplete_orders/{orderId} {
        allow read, write: if isShopAdmin(shopId);
      }

      match /counters/{counterId} {
        allow read, write: if isShopAdmin(shopId);
      }

      match /staff/{staffId} {
        allow read: if isShopAdmin(shopId);
        allow write: if isShopOwner(shopId) || isSuperAdmin();
      }

      match /customers/{customerId} {
        allow read: if isShopAdmin(shopId);
        allow write: if isShopAdmin(shopId);
      }

      // Reviews: public read, created via server API (no client create)
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if false; // Server-only via Admin SDK
        allow update, delete: if isShopAdmin(shopId);
      }

      // Broadcasts: admin-only (log of sent broadcasts)
      match /broadcasts/{broadcastId} {
        allow read: if isShopAdmin(shopId);
        allow create: if false; // Server-only via Admin SDK
        allow update, delete: if false;
      }

      // Private Configs: only accessible by the shop owner (retailer)
      match /private_configs/{configId} {
        allow read, write: if isShopOwner(shopId);
      }

      // Social Hub & Omnichannel Sub-collections
      match /conversations/{convId} {
        allow read: if isShopAdmin(shopId) || convId.matches('^vis_.*');
        allow write: if isShopAdmin(shopId);
      }

      match /leads/{leadId} {
        allow read, write: if isShopAdmin(shopId);
      }

      match /team/{teamId} {
        allow read: if isShopAdmin(shopId);
        allow write: if isShopOwner(shopId) || isSuperAdmin();
      }
    }
    
    // ── System Logs & Broadcasts ──────────────────────────────────
    match /impersonation_logs/{logId} {
      allow create: if isSuperAdmin();
      allow read: if isSuperAdmin();
    }

    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /social_connections/{connId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /{path=**}/conversations/{convId} {
      allow read: if isSuperAdmin();
    }

    match /{path=**}/leads/{leadId} {
      allow read: if isSuperAdmin();
    }

    // ── Server-Managed Collections (Admin SDK only) ──────────
    match /platform_reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /otp_codes/{otpId} {
      allow read, write: if false;
    }

    match /otp_rate_limits/{limitId} {
      allow read, write: if false;
    }

    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    
    match /fraud_profiles/{phone} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    // ── Default Deny ───────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
